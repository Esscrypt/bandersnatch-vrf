{
  "name": "pbnjam-ring-proof-native",
  "version": "0.1.0",
  "description": "Native Rust ring proof connector (w3f ring proof lines 299-316)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "pbnjam_ring_proof",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "artifacts": "bunx napi artifacts",
    "build": "bunx napi build --platform --release native",
    "build:debug": "bunx napi build --platform native",
    "clean": "rm -rf target/ && rm -rf native/"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
